{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zettelfrei",
  "version": "0.7.1",
  "identifier": "io.github.uzerwod-boop.zettelfrei",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zettelfrei",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi"
    ],
    "category": "Productivity",
    "shortDescription": "Excel-Tabellen mit Sätzen bedienen",
    "longDescription": "Zettelfrei öffnet vorhandene Excel-Dateien und bedient sie mit Sätzen – dazu E-Rechnung, Arbeitszeitgesetz, Mahnwesen und Abnahmeprotokoll. Die Datei bleibt auf dem eigenen Rechner.",
    "copyright": "© 2026 Bohdan Sychevskyi · MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "German",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "publisher": "Bohdan Sychevskyi",
    "homepage": "https://github.com/uzerwod-boop/zettelfrei",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNjcwRERGMDRGOEUzREUKUldUZTQvZ0UzdzFuYkxvdmI1NTcvMFJwWDVFSmNrdVZYVUxhVWp5Yjd1Qkh2cTU5K3ZZYzhodVIK",
      "endpoints": [
        "https://github.com/uzerwod-boop/zettelfrei/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
